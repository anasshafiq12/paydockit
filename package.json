{
  "name": "paydockit",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n public,tools -c blue,green \"npm run dev -w apps/public-site\" \"npm run dev -w apps/private-tools\"",
    "build": "npm run build -w apps/private-tools && npm run build -w apps/public-site && node scripts/optimize-public.mjs && node scripts/headers.mjs && node scripts/check-build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p apps/private-tools/tsconfig.json --noEmit && tsc -p apps/public-site/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/noto-nastaliq-urdu": "5.3.0",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "decimal.js": "10.6.0",
    "docx": "9.15.0",
    "jspdf": "4.2.1",
    "jszip": "3.10.1",
    "lucide-react": "0.577.0",
    "next": "16.4.3",
    "papaparse": "5.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "9.2.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
